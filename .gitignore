# Ambiente virtual
.venv/
venv/
env/

# Cache e arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class

# Cache e relatórios de testes/cobertura
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Bancos de dados e dados locais (inclusive homologação e backups aninhados)
data/**
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
*.db-backup
*.db-bak

# Arquivos temporários locais e resultados avulsos de testes
tmp/
temp/
test-results/
*.tmp
*.temp
*.log

# Variáveis de ambiente e segredos locais
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.local.*
secrets.local.*

# Ferramentas de análise Python
.mypy_cache/
.ruff_cache/
.pyright/

# Editores e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
